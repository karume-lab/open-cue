{
  "name": "cue",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "dev": "NODE_NO_WARNINGS=1 expo start --dev-client",
    "start": "NODE_NO_WARNINGS=1 expo start",
    "android": "expo prebuild --clean && expo run:android",
    "build": "expo prebuild --clean && ./android/gradlew -p android assembleRelease",
    "install-apk": "adb install ./android/app/build/outputs/apk/release/app-release.apk",
    "build:install-apk": "bun run build && bun install-apk",
    "doctor": "expo-doctor --verbose",
    "update-packages": "expo install --check",
    "reinstall-packages": "rm -rf node_modules bun.lock && bun i",
    "lint": "biome check",
    "format": "biome format",
    "check": "biome check",
    "clean": "biome check --write",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:migrate": "drizzle-kit migrate"
  },
