{
  "expo": {
    "name": "Cue",
    "slug": "cue",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./public/core/icon.png",
    "scheme": "cue",

    "assetBundlePatterns": ["**/*"],
    "platforms": ["ios", "android"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.karume-lab.cue",
      "userInterfaceStyle": "automatic"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "public/core/adaptive-icon.png"
      },
      "package": "com.karume_lab.cue",
      "userInterfaceStyle": "dark"
    },
    "plugins": [
      "expo-router",
      "expo-asset",
      "expo-background-task",
      "expo-task-manager",
      [
        "expo-build-properties",
        {
          "android": {
            "buildArchs": ["arm64-v8a"],
            "useLegacyPackaging": true,
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "enableBundleCompression": true,
            "extraProguardRules": "-keep class com.brentvatne.** { *; }\n-keep class com.horcrux.svg.** { *; }"
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "public/core/splash-icon.png",
          "backgroundColor": "#ffffff",
          "dark": {
            "image": "public/core/splash-icon-dark.png",
            "backgroundColor": "#222222"
          }
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Allow Cue to access your photos so it can save downloaded videos.",
          "savePhotosPermission": "Allow Cue to save downloaded videos to your photo library.",
          "granularPermissions": ["photo", "video"]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
